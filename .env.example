# ============================================================
# 環境変数サンプル (.env.local にコピーして値を入力する)
#
# 設定先の凡例:
#   [GitHub]     → GitHub Settings > Environments > Secrets
#                  ビルド時（pnpm build）に Next.js へ埋め込まれる
#   [Cloudflare] → wrangler secret put --config wrangler.<env>.jsonc
#                  Cloudflare Worker のランタイムで読まれる
#   [Local]      → .env.local のみ。本番環境への登録不要
#   [CI]         → GitHub Secrets（ビルドには使わないが CI ジョブが必要とする）
# ============================================================


# ────────────────────────────────────────
# Sentry（エラー監視）
# ────────────────────────────────────────

# [GitHub] ビルド時に埋め込む
NEXT_PUBLIC_SENTRY_DSN=           # Sentry DSN（stg/prod 共通プロジェクト）
NEXT_PUBLIC_SENTRY_ENVIRONMENT=dev  # dev | stg | prod（CI workflow 内でハードコード済み）

# [CI] ソースマップのアップロードに使用（ローカルビルドでは不要）
# SENTRY_AUTH_TOKEN=


# ────────────────────────────────────────
# Clerk（認証）
# ────────────────────────────────────────

# [GitHub] ビルド時に埋め込む
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # pk_test_... (dev/stg) / pk_live_... (prod)

# [Cloudflare] Worker ランタイムで使用
CLERK_SECRET_KEY=                   # sk_test_... (dev/stg) / sk_live_... (prod)
CLERK_WEBHOOK_SECRET=               # Clerk ダッシュボードの Webhook エンドポイントで発行


# ────────────────────────────────────────
# Supabase（データベース）
# ────────────────────────────────────────

# [GitHub] ビルド時に埋め込む
NEXT_PUBLIC_SUPABASE_URL=           # https://<ref>.supabase.co（ローカルは http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # anon キー（公開可。RLS で保護される）

# [Cloudflare] Worker ランタイムで使用
SUPABASE_SERVICE_ROLE_KEY=          # service_role キー（全権限。絶対に公開しない）

# [CI] supabase db push（DB マイグレーション）に使用
SUPABASE_ACCESS_TOKEN=              # Supabase CLI 認証トークン（supabase.com > Account > Access Tokens）


# ────────────────────────────────────────
# Stripe（決済）
# ────────────────────────────────────────

# [GitHub] ビルド時に埋め込む
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # pk_test_... (dev/stg) / pk_live_... (prod)

# [Cloudflare] Worker ランタイムで使用
STRIPE_SECRET_KEY=                  # sk_test_... (dev/stg) / sk_live_... (prod)
STRIPE_WEBHOOK_SECRET=              # whsec_...（ローカルは stripe listen が発行するシークレット）
# 7ランクモデル（specs/001-seven-rank-pricing）。詳細はspecs/001-seven-rank-pricing/stripe-price-ids.md参照
STRIPE_PRICE_ID_STARTER=            # price_...（STARTERプランの月額 Price ID）
STRIPE_PRICE_ID_STARTER_INITIAL_FEE= # price_...（STARTERプランの初期費用 Price ID）
STRIPE_PRICE_ID_BASIC=              # price_...（BASICプランの月額 Price ID）
STRIPE_PRICE_ID_BASIC_INITIAL_FEE=  # price_...（BASICプランの初期費用 Price ID）
STRIPE_PRICE_ID_STANDARD=           # price_...（STANDARDプランの月額 Price ID）
STRIPE_PRICE_ID_STANDARD_INITIAL_FEE= # price_...（STANDARDプランの初期費用 Price ID）
STRIPE_PRICE_ID_PRO=                # price_...（PROプランの月額 Price ID）
STRIPE_PRICE_ID_PRO_INITIAL_FEE=    # price_...（PROプランの初期費用 Price ID）
STRIPE_PRICE_ID_ADVANCED=           # price_...（ADVANCEDプランの月額 Price ID）
STRIPE_PRICE_ID_ADVANCED_INITIAL_FEE= # price_...（ADVANCEDプランの初期費用 Price ID）
STRIPE_PRICE_ID_PREMIUM=            # price_...（PREMIUMプランの月額 Price ID）
STRIPE_PRICE_ID_PREMIUM_INITIAL_FEE= # price_...（PREMIUMプランの初期費用 Price ID）


# ────────────────────────────────────────
# Sanity（CMS）
# ────────────────────────────────────────

# [GitHub] ビルド時に埋め込む
NEXT_PUBLIC_SANITY_PROJECT_ID=      # Sanity プロジェクト ID（全環境共通）
NEXT_PUBLIC_SANITY_DATASET=staging  # staging | production（CI workflow 内でハードコード済み）

# [Cloudflare] Worker ランタイムで使用（読み取り専用トークン）
SANITY_API_TOKEN=                   # Sanity > API > Tokens で発行（viewer 権限）

# [Local] seed スクリプト（scripts/seed-products.ts）専用。本番環境への登録不要
SANITY_WRITE_TOKEN=                 # Sanity > API > Tokens で発行（editor 権限）


# ────────────────────────────────────────
# Resend（メール送信）
# ────────────────────────────────────────

# [Cloudflare] Worker ランタイムで使用
RESEND_API_KEY=                     # re_...（Resend ダッシュボードで発行）
RESEND_FROM_EMAIL=                  # 送信元アドレス（Resend で認証済みドメインのもの）
RESEND_ADMIN_EMAIL=                 # 運営者への注文通知の送信先アドレス

# [Local] ローカルでは本番アドレスに送らないよう、このアドレスに上書きする
RESEND_TEST_TO=                     # テスト送信先（自分のメールアドレスなど）

# [CI/E2E] trueにするとResend APIを一切呼び出さない（送信数使用枠を消費しないため）
DISABLE_EMAIL_SENDING=


# ────────────────────────────────────────
# アプリ全般
# ────────────────────────────────────────

# [GitHub] ビルド時に埋め込む
NEXT_PUBLIC_APP_URL=http://localhost:3000  # ローカル: http://localhost:3000 / stg・prod は各 URL

# ────────────────────────────────────────
# E2E テスト（Playwright）
# ────────────────────────────────────────

# [CI] stg 環境での E2E テスト実行時に使用
# [Local] ローカルで pnpm test:e2e を実行する場合も必要
E2E_USER_EMAIL=                     # Clerk に作成したテスト用アカウントのメールアドレス（+clerk_test を含めること）
E2E_USER_PASSWORD=                  # 上記アカウントのパスワード
